---
import Icon, { type IconName } from "../components/Icon.astro";
import Browser from "../components/Browser.astro";
import Logo from "../components/Logo.astro";
import Phone from "../components/Phone.astro";
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import AgentChat from "../components/AgentChat.astro";
import { buttonRow, euroSign, eyebrow, indicator, primaryButton, secondaryButton, sectionTitle } from "../classes";
import { appLinks, cloudBilling, demoLinkAttrs, externalLinkAttrs, sourceUrl } from "../site";

import bancosOscuro from "../assets/screens/bancos-oscuro.jpg";
import bancos from "../assets/screens/bancos.jpg";
import bancosMovilOscuro from "../assets/screens/bancos-movil-oscuro.jpg";
import bancosMovil from "../assets/screens/bancos-movil.jpg";
import calendarioMovilOscuro from "../assets/screens/calendario-movil-oscuro.jpg";
import calendarioMovil from "../assets/screens/calendario-movil.jpg";
import calendarioOscuro from "../assets/screens/calendario-oscuro.jpg";
import calendario from "../assets/screens/calendario.jpg";
import facturasMovilOscuro from "../assets/screens/facturas-movil-oscuro.jpg";
import facturasMovil from "../assets/screens/facturas-movil.jpg";
import facturasOscuro from "../assets/screens/facturas-oscuro.jpg";
import facturas from "../assets/screens/facturas.jpg";
import gastosMovilOscuro from "../assets/screens/gastos-movil-oscuro.jpg";
import gastosMovil from "../assets/screens/gastos-movil.jpg";
import gastosOscuro from "../assets/screens/gastos-oscuro.jpg";
import gastos from "../assets/screens/gastos.jpg";
import impuestosMovilOscuro from "../assets/screens/impuestos-movil-oscuro.jpg";
import impuestosMovil from "../assets/screens/impuestos-movil.jpg";
import impuestosOscuro from "../assets/screens/impuestos-oscuro.jpg";
import impuestos from "../assets/screens/impuestos.jpg";
import inicioMovilOscuro from "../assets/screens/inicio-movil-oscuro.jpg";
import inicioMovil from "../assets/screens/inicio-movil.jpg";
import inicioOscuro from "../assets/screens/inicio-oscuro.jpg";
import inicio from "../assets/screens/inicio.jpg";

const title = "cuentalibre: facturas e impuestos para autónomos, de código abierto";
const description =
  "Facturas, gastos, IVA e IRPF para autónomos en una app de código abierto. Gratis en tu propio servidor, o alojada por nosotros desde 3,99 € al mes.";

/** Screens of the app the hero switches between, in light and dark; captured from the demo. */
const screens: {
  id: string;
  label: string;
  text: string;
  icon: IconName;
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  desktopDark: ImageMetadata;
  mobileDark: ImageMetadata;
  alt: string;
}[] = [
  {
    id: "inicio",
    label: "Inicio",
    text: "Ingresos, gastos, beneficio e impuestos del año, de un vistazo.",
    icon: "layout-dashboard",
    desktop: inicio,
    mobile: inicioMovil,
    desktopDark: inicioOscuro,
    mobileDark: inicioMovilOscuro,
    alt: "Inicio: resumen del año con ingresos, gastos, beneficio e impuestos estimados",
  },
  {
    id: "facturas",
    label: "Facturas",
    text: "Facturas, presupuestos y albaranes ilimitados, con numeración correlativa y PDF.",
    icon: "receipt",
    desktop: facturas,
    mobile: facturasMovil,
    desktopDark: facturasOscuro,
    mobileDark: facturasMovilOscuro,
    alt: "Lista de facturas emitidas del año",
  },
  {
    id: "impuestos",
    label: "Impuestos",
    text: "El IVA y el IRPF de cada trimestre, casilla a casilla, listos para presentar.",
    icon: "percent",
    desktop: impuestos,
    mobile: impuestosMovil,
    desktopDark: impuestosOscuro,
    mobileDark: impuestosMovilOscuro,
    alt: "Resumen de impuestos por trimestre",
  },
  {
    id: "gastos",
    label: "Gastos",
    text: "Cada gasto con su parte deducible, sin tope al mes.",
    icon: "shopping-bag",
    desktop: gastos,
    mobile: gastosMovil,
    desktopDark: gastosOscuro,
    mobileDark: gastosMovilOscuro,
    alt: "Lista de gastos con su parte deducible",
  },
  {
    id: "calendario",
    label: "Calendario",
    text: "Cada plazo fiscal que te afecta, con el importe antes de que llegue.",
    icon: "calendar-check",
    desktop: calendario,
    mobile: calendarioMovil,
    desktopDark: calendarioOscuro,
    mobileDark: calendarioMovilOscuro,
    alt: "Calendario fiscal con los plazos y sus importes",
  },
  {
    id: "bancos",
    label: "Bancos",
    text: "Cada cobro y pago de tus facturas y gastos, con la cuenta por la que pasó.",
    icon: "landmark",
    desktop: bancos,
    mobile: bancosMovil,
    desktopDark: bancosOscuro,
    mobileDark: bancosMovilOscuro,
    alt: "Cobros y pagos por cuenta bancaria",
  },
];

/** Ways a document reaches the expense scanner; listed beside its clip on wide screens. */
const scannerWays: { icon: IconName; title: string; text: string }[] = [
  { icon: "smartphone", title: "Desde el móvil", text: "Haz una foto al ticket nada más pagar." },
  { icon: "monitor", title: "Desde el ordenador", text: "Arrastra el PDF de la factura que te llega por correo." },
  { icon: "scan-text", title: "Tú solo revisas", text: "Proveedor, fecha, base e IVA salen leídos del documento." },
];

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "code",
    title: "Código abierto",
    text: "Cada cálculo de IVA e IRPF está a la vista. Puedes revisarlo, auditarlo y mejorarlo.",
  },
  {
    icon: "lock-keyhole",
    title: "Privado por defecto",
    text: "Tus datos fiscales no son nuestro negocio. Expórtalos o bórralos cuando quieras.",
  },
  {
    icon: "hand-coins",
    title: "Gratis de verdad",
    text: "Facturas y gastos ilimitados, impuestos incluidos. Sin plan recortado.",
  },
];

/** What an agent can do, beside the chat on wide screens */
const agentPoints: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "message-circle",
    title: "Pregunta como hablarías",
    text: "Cuánto IVA llevas, quién te debe o cómo va el año, con los datos de tu cuenta.",
  },
  {
    icon: "receipt",
    title: "Hace el trabajo",
    text: "Apunta gastos a partir de un ticket y te prepara las facturas del mes como borradores.",
  },
  {
    icon: "lock-keyhole",
    title: "Tú tienes el control",
    text: "Cada agente usa su propia clave, que revocas cuando quieras. Un trimestre cerrado no se toca.",
  },
];

/** Comparison rows: a string is shown as text, a boolean as a check or a cross. */
const comparison: { label: string; badge?: string; others: string | boolean; ours: string | boolean }[] = [
  { label: "Facturas y gastos ilimitados", others: "De pago", ours: "Gratis" },
  { label: "IVA, IRPF y calendario fiscal", others: "De pago", ours: "Gratis" },
  { label: "Conéctalo a tus agentes de IA", badge: "API incluida", others: "De pago", ours: "Gratis" },
  { label: "Código abierto y auditable", others: false, ours: true },
  { label: "Puedes instalarlo en tu servidor", others: false, ours: true },
  { label: "Tus datos son privados", others: false, ours: true },
];

const freePlan = [
  "Facturas, presupuestos y gastos ilimitados",
  "IVA e IRPF de cada trimestre, ya calculados",
  "Calendario fiscal y cierre de trimestre",
  "Cobros, pagos e informes",
  "API para tus agentes de IA",
  "Tus datos no salen de tu servidor",
];

const onlinePlan = [
  "Sin instalar nada, desde cualquier navegador",
  "Actualizaciones automáticas",
  "Copia de seguridad diaria",
  "Exporta tus datos cuando quieras",
];

const faq = [
  {
    question: "¿Por qué es gratis?",
    answer:
      "Porque el código es libre (licencia AGPL-3.0) y cualquiera puede instalarlo. El desarrollo lo paga cuentalibre Cloud, la versión que alojamos nosotros para quien no quiere ocuparse de un servidor. La versión gratuita tiene todas las funciones.",
  },
  {
    question: "¿Puedo fiarme de los cálculos de IVA e IRPF?",
    answer:
      "Sí. Los cálculos de IVA e IRPF tienen pruebas automáticas, y el código es abierto para que cualquiera pueda auditarlo. Aun así, revisa lo que presentes: cuentalibre prepara los modelos, pero no los presenta por ti.",
  },
  {
    question: "¿Necesito saber de servidores?",
    answer:
      'Para instalarlo tú, sí: hace falta manejar un servidor Linux con Docker. Si no es tu caso, <a href="#precio">cuentalibre Cloud</a> funciona desde el navegador, con las mismas funciones.',
  },
  {
    question: "¿Necesito tarjeta para probar cuentalibre Cloud?",
    answer:
      "No. Tienes 30 días con todas las funciones y la tarjeta solo te la pedimos si decides suscribirte. Si no lo haces, tu cuenta queda en modo lectura: puedes ver y exportar todo.",
  },
  {
    question: "¿Envía mis facturas a Hacienda con VERI*FACTU?",
    answer:
      "Todavía no: VERI*FACTU llegará próximamente. Mientras tanto, emites tus facturas con cuentalibre sin enviarlas a la AEAT.",
  },
  {
    question: "¿Sirve para cualquier negocio?",
    answer:
      "Está pensada para autónomos en estimación directa. No cubre módulos (estimación objetiva), la contabilidad de sociedades ni las nóminas.",
  },
  {
    question: "¿Mis datos son míos?",
    answer:
      "Sí. Puedes exportarlos todos cuando quieras. En tu servidor no salen de él; en cuentalibre Cloud se guardan en servidores de la Unión Europea.",
  },
];

/** Where the free edition starts: the self-hosting guide. */
const installUrl = "/docs/instalar";

const defaultBilling = "yearly";


const phoneShot =
  "mx-auto w-[min(260px,72vw)] md:absolute md:right-[-12px] md:bottom-0 md:mx-0 md:w-[21%] md:max-w-[250px]";
---

<Base title={title} description={description}>
  <main>
    <section class="relative isolate mx-auto max-w-[1200px] px-4 pt-6 text-center sm:px-6 sm:pt-8 md:pt-10">
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[620px] bg-hero-glow"></div>
      <h1
        class="mx-auto mt-2 mb-0 animate-rise-in font-display text-[clamp(36px,5.2vw,64px)] sm:mt-4 leading-[1.02] font-semibold tracking-[-0.03em] text-balance"
      >
        Tus impuestos, bajo control.
      </h1>
      <p class="mx-auto mt-5 mb-0 max-w-[600px] animate-rise-in text-[17px] [--i:2] leading-normal sm:mt-6 sm:text-[19px] text-pretty text-muted-foreground">
        Facturas, gastos, IVA e IRPF para autónomos.{" "}<br class="max-sm:hidden" />De{" "}
        <strong class="font-medium text-foreground">código abierto</strong> y{" "}
        <strong class="font-medium text-foreground">gratis</strong> en tu propio servidor.
      </p>
      <div class:list={[buttonRow, "mt-8 animate-rise-in [--i:4] sm:mt-9"]}>
        <a href={appLinks.demo} {...demoLinkAttrs} class={primaryButton}>
          Probar la demo<Icon name="arrow-right" class="size-[18px]" />
        </a>
        <a href="#precio" class={secondaryButton}>Instalar gratis</a>
      </div>
    </section>

    <section id="funciones" class="mx-auto mt-8 max-w-[1240px] scroll-mt-24 animate-rise-in px-4 [--i:6] sm:mt-10 sm:px-6" data-screens>
      <div
        role="tablist"
        aria-label="Pantallas de la app"
        data-indicator-group
        class="scrollbar-none relative mx-auto flex w-full max-w-full gap-1 overflow-x-auto rounded-full bg-muted p-1 sm:w-fit md:flex-wrap md:justify-center"
      >
        <span data-indicator aria-hidden="true" class={indicator}></span>
        {
          screens.map((screen, i) => (
            <button
              type="button"
              role="tab"
              id={`pantalla-${screen.id}`}
              aria-controls={`panel-${screen.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              aria-label={screen.label}
              class="group inline-flex shrink-0 items-center justify-center gap-[7px] rounded-full border-0 bg-transparent px-2.5 py-2 max-sm:flex-1 max-sm:aria-selected:flex-auto sm:px-3.5 whitespace-nowrap font-[inherit] text-[15px] font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-tab relative z-10 in-data-ready:aria-selected:bg-transparent in-data-ready:aria-selected:shadow-none"
            >
              <Icon name={screen.icon} class="size-[17px]" />
              {/* Phones show only the icons, and the label of the chosen screen */}
              <span class="max-sm:hidden max-sm:group-aria-selected:inline">{screen.label}</span>
            </button>
          ))
        }
      </div>
      {
        screens.map((screen, i) => (
          <div role="tabpanel" id={`panel-${screen.id}`} aria-labelledby={`pantalla-${screen.id}`} hidden={i !== 0}>
            <p class="mx-auto mt-4 mb-0 max-w-[560px] px-2 text-center text-[15px] text-pretty text-muted-foreground sm:text-base">{screen.text}</p>
            <div data-shot="light" class="relative mt-5 md:pb-12 dark:hidden">
              <Browser
                src={screen.desktop}
                alt={screen.alt}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                class="hidden md:block"
              />
              <Phone src={screen.mobile} alt="cuentalibre en el móvil" loading={i === 0 ? "eager" : "lazy"} class={phoneShot} />
            </div>
            {/* The same screens in the app's dark theme, shown while the site is dark */}
            <div data-shot="dark" class="relative mt-5 hidden md:pb-12 dark:block">
              <Browser src={screen.desktopDark} alt={`${screen.alt}, en modo oscuro`} class="hidden md:block" />
              <Phone src={screen.mobileDark} alt="cuentalibre en el móvil, en modo oscuro" class={phoneShot} />
            </div>
          </div>
        ))
      }
    </section>

    <section id="escaner" class="mx-auto mt-14 max-w-[1200px] px-4 sm:mt-20 sm:px-6 md:mt-16">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,620px)] lg:items-start lg:gap-14">
        <div data-reveal class="text-left lg:pt-6">
          <div class={eyebrow}>Escáner de gastos</div>
          <h2 class:list={[sectionTitle, "mt-2 mb-0"]}>Del ticket al trimestre, sin teclear.</h2>
          <p class="mt-4 mb-0 max-w-[520px] text-[17px] text-muted-foreground">
            Haz una foto al ticket o sube la factura, y cuentalibre la apunta sola en su trimestre.
          </p>
          <ul class="m-0 mt-10 hidden list-none flex-col gap-7 p-0 lg:flex">
            {
              scannerWays.map((way) => (
                <li class="grid grid-cols-[24px_1fr] items-start gap-x-4">
                  <Icon name={way.icon} class="mt-1 size-[22px] text-primary-soft-foreground" />
                  <h3 class="m-0 font-display text-[24px] leading-tight font-semibold tracking-[-0.015em]">{way.title}</h3>
                  <p class="col-start-2 mt-1.5 mb-0 text-muted-foreground">{way.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal style={{ "--i": 1 }} class="mx-auto mt-8 max-w-[620px] lg:mt-0 lg:max-w-none">
          <video
            data-scanner
            class="block aspect-[4/3] w-full [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent),linear-gradient(to_bottom,transparent,black_5%,black_92%,transparent)] [mask-composite:intersect]"
            muted
            loop
            playsinline
            preload="none"
            aria-label="Un ticket desde la app y una factura en PDF desde el ordenador se escanean y quedan registrados como gastos del trimestre."
          ></video>
        </div>
      </div>
    </section>

    <section id="agentes" class="mx-auto mt-10 max-w-[1200px] px-4 sm:mt-20 sm:px-6 md:mt-30">
      <div class="lg:grid lg:grid-cols-[minmax(0,540px)_minmax(0,1fr)] lg:items-start lg:gap-16">
        <div class="text-left lg:order-2 lg:pt-6">
          <div data-reveal>
            <div class={eyebrow}>Agentes de IA</div>
            <h2 class:list={[sectionTitle, "mt-2 mb-0"]}>Pídeselo a tu agente.</h2>
            <p class="mt-4 mb-0 max-w-[520px] text-[17px] text-muted-foreground">
              Conecta Claude o ChatGPT a tu cuenta. Responden con tus datos reales y hacen el trabajo por ti.
            </p>
          </div>
          <ul class="m-0 mt-10 hidden list-none flex-col gap-7 p-0 lg:flex">
            {
              agentPoints.map((point, i) => (
                <li data-reveal style={{ "--i": i + 1 }} class="grid grid-cols-[24px_1fr] items-start gap-x-4">
                  <Icon name={point.icon} class="mt-1 size-[22px] text-primary-soft-foreground" />
                  <h3 class="m-0 font-display text-[24px] leading-tight font-semibold tracking-[-0.015em]">{point.title}</h3>
                  <p class="col-start-2 mt-1.5 mb-0 max-w-[460px] text-muted-foreground">{point.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal style={{ "--i": 1 }} class="mt-10 lg:order-1 lg:mt-0">
          <AgentChat />
          <div class="mt-6 flex flex-col items-start gap-x-6 gap-y-3 sm:flex-row sm:items-center">
            <a href="/docs/agentes" class="inline-flex items-center gap-1.5 font-semibold text-primary no-underline hover:text-primary-hover">
              Cómo conectar un agente<Icon name="arrow-right" class="size-[17px]" />
            </a>
            <a href="/docs/api" class="font-medium text-muted-foreground no-underline hover:text-foreground">Referencia de la API</a>
          </div>
        </div>
      </div>
    </section>

    <section id="codigo-abierto" class="mx-auto mt-16 max-w-[1200px] px-4 sm:mt-24 sm:px-6 md:mt-34">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)] lg:items-center lg:gap-16">
        <div>
          <div data-reveal class="text-left">
            <div class={eyebrow}>Por qué cuentalibre</div>
            <h2 class:list={[sectionTitle, "mt-2 mb-0"]}>Tus cuentas son <em>tuyas</em>.</h2>
            <p class="mt-4 mb-0 hidden max-w-[520px] text-[17px] text-muted-foreground lg:block">
              Tus datos fiscales, con un software que puedes revisar, auditar y ejecutar en tu propio servidor.
            </p>
          </div>
          <ul class="m-0 mt-8 grid list-none grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6 p-0 sm:mt-12 sm:gap-10 lg:mt-10 lg:grid-cols-1 lg:gap-7">
            {
              reasons.map((reason, i) => (
                <li
                  data-reveal
                  style={{ "--i": i }}
                  class="grid grid-cols-[20px_1fr] items-center gap-x-3 sm:block lg:grid lg:grid-cols-[24px_1fr] lg:items-start lg:gap-x-4"
                >
                  <div class="flex items-center justify-center text-primary-soft-foreground sm:size-11 sm:rounded-[12px] sm:bg-primary-soft lg:mt-1 lg:size-6 lg:rounded-none lg:bg-transparent">
                    <Icon name={reason.icon} class="size-5 sm:size-[22px]" />
                  </div>
                  <h3 class="m-0 text-[18px] font-semibold tracking-[-0.015em] sm:mt-5 sm:text-[20px] lg:mt-0 lg:font-display lg:text-[24px] lg:leading-tight">
                    {reason.title}
                  </h3>
                  <p class="col-start-2 mt-1 mb-0 text-muted-foreground sm:mt-2 lg:mt-1.5">{reason.text}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-reveal style={{ "--i": 2 }} class="mx-auto mt-12 max-w-[760px] overflow-hidden rounded-2xl border border-accent sm:mt-16 lg:mt-0 lg:max-w-none">
          <div class="px-5 py-6 sm:px-10 sm:py-8 lg:px-7">
            <table class="w-full border-separate border-spacing-0 text-[14px] sm:text-[15px]">
              <thead>
                <tr>
                  <th scope="col" class="py-2.5"><span class="sr-only">Función</span></th>
                  <th scope="col" class="w-[76px] pb-3 align-bottom text-center text-xs font-medium sm:w-24 sm:text-sm text-muted-foreground">Otros</th>
                  <th scope="col" class="w-[96px] rounded-t-xl bg-primary-soft pt-4 pb-3 align-bottom text-xs font-semibold text-primary-soft-foreground sm:w-28 sm:text-sm">
                    <span class="flex flex-col items-center gap-1.5">
                      <Logo class="h-[22px] w-5 text-foreground" />
                      cuentalibre
                    </span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  comparison.map((row, i) => (
                    <tr>
                      <th scope="row" class="border-t border-divider py-3.5 pr-2 text-left font-normal sm:py-4">
                        <span class="flex flex-wrap items-center gap-2">
                          {row.label}
                          {row.badge && (
                            <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-semibold text-primary-soft-foreground">
                              {row.badge}
                            </span>
                          )}
                        </span>
                      </th>
                      <td class="border-t border-divider py-4 text-center text-sm text-muted-foreground">
                        {typeof row.others === "string" ? (
                          row.others
                        ) : (
                          <Icon name="x" label="No" class="mx-auto block size-[18px] text-input" />
                        )}
                      </td>
                      <td
                        class:list={[
                          "border-t border-primary-soft-foreground/15 bg-primary-soft py-4 text-center text-sm font-semibold text-primary-soft-foreground",
                          i === comparison.length - 1 && "rounded-b-xl",
                        ]}
                      >
                        {typeof row.ours === "string" ? (
                          row.ours
                        ) : (
                          <span class="mx-auto flex size-6 items-center justify-center rounded-full bg-primary text-primary-foreground">
                            <Icon name="check" label="Sí" class="size-3.5 [stroke-width:3]" />
                          </span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="precio" class="mx-auto mt-16 sm:mt-24 md:mt-34 max-w-[1200px] px-4 sm:px-6" data-billing={defaultBilling}>
      <div data-reveal class="text-center">
        <div class={eyebrow}>Precio</div>
        <h2 class:list={[sectionTitle, "mx-auto mt-2 mb-0"]}>Gratis en tu servidor. En Cloud si prefieres no instalar nada.</h2>
        <p class="mx-auto mt-3.5 mb-0 max-w-[540px] text-[17px] text-muted-foreground">
          Las dos opciones tienen todas las funciones. Solo cambia quién se encarga del servidor.
        </p>
        <div
          role="group"
          aria-label="Forma de pago"
          data-indicator-group
