---
import Base from "../layouts/Base.astro";
import { appLinks, cloudPrice, sourceUrl } from "../site";

const title = "cuentalibre: contabilidad e impuestos para autónomos";
const description =
  "Facturas, gastos, IVA e IRPF en un solo sitio. cuentalibre calcula tus modelos 303 y 130, te avisa de cada plazo y es software libre.";
const features = [
  {
    title: "Facturación",
    text: "Facturas, presupuestos y albaranes con numeración correlativa y PDF listo para enviar.",
  },
  {
    title: "Compras y gastos",
    text: "Registra facturas recibidas y gastos deducibles con sus justificantes.",
  },
  {
    title: "IVA e IRPF al día",
    text: "Modelos 303, 130, 390, 111, 115 y 347 calculados casilla a casilla a partir de tus documentos.",
  },
  {
    title: "Calendario fiscal",
    text: "Cada plazo que te afecta, con el importe estimado antes de que llegue.",
  },
  {
    title: "Informes",
    text: "Pérdidas y ganancias, resumen del año y comparativa con el anterior.",
  },
  {
    title: "Software libre",
    text: "Código abierto bajo AGPL-3.0. Úsalo en la nube o instálalo en tu propio servidor.",
  },
];
---

<Base title={title} description={description}>
  <main>
      <section class="mx-auto max-w-3xl px-4 pt-16 pb-20 text-center sm:px-6 sm:pt-24">
        <h1 class="m-0 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          La contabilidad y los impuestos de tu negocio, sin hojas de cálculo
        </h1>
        <p class="mx-auto mt-5 mb-0 max-w-xl text-lg text-pretty text-muted-foreground">
          cuentalibre es la herramienta para autónomos en España: facturas, gastos, IVA e IRPF en un solo sitio, con cada
          modelo calculado a partir de tus documentos.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href={appLinks.signUp}
            class="rounded-xl bg-primary px-6 py-3 text-md font-semibold text-primary-foreground hover:bg-primary-hover"
          >
            Crear cuenta
          </a>
          <a
            href={appLinks.demo}
            class="rounded-xl border border-input bg-secondary px-6 py-3 text-md font-medium text-secondary-foreground hover:bg-muted"
          >
            Probar la demo
          </a>
        </div>
        <p class="mt-3 mb-0 text-sm text-muted-foreground">La demo usa datos de ejemplo y no necesita cuenta.</p>
      </section>

      <section class="border-t border-border bg-muted">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
          <h2 class="m-0 text-2xl font-semibold">Todo lo que necesitas cada trimestre</h2>
          <ul class="m-0 mt-8 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
            {
              features.map((feature) => (
                <li class="rounded-xl border border-border bg-card p-5 text-card-foreground">
                  <h3 class="m-0 text-md font-semibold">{feature.title}</h3>
                  <p class="mt-2 mb-0 text-muted-foreground">{feature.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
        <h2 class="m-0 text-2xl font-semibold">Precio</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-primary bg-card p-6 text-card-foreground">
            <h3 class="m-0 text-md font-semibold">cuentalibre Cloud</h3>
            <p class="mt-3 mb-0">
              <span class="amount text-3xl font-semibold">{cloudPrice}</span>
              <span class="text-muted-foreground"> al mes, IVA incluido</span>
            </p>
            <p class="mt-3 mb-0 text-muted-foreground">
              Nosotros alojamos, actualizamos y hacemos copias de seguridad cada noche. Tus datos se guardan en la Unión
              Europea y puedes exportarlos o borrarlos cuando quieras.
            </p>
            <a
              href={appLinks.signUp}
              class="mt-5 inline-block rounded-xl bg-primary px-5 py-2.5 font-semibold text-primary-foreground hover:bg-primary-hover"
            >
              Crear cuenta
            </a>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 text-card-foreground">
            <h3 class="m-0 text-md font-semibold">En tu propio servidor</h3>
            <p class="mt-3 mb-0">
              <span class="amount text-3xl font-semibold">0 €</span>
              <span class="text-muted-foreground"> siempre</span>
            </p>
            <p class="mt-3 mb-0 text-muted-foreground">
              La misma aplicación, sin funciones recortadas. Tú te encargas del servidor, las copias y las
              actualizaciones.
            </p>
            <a
              href={sourceUrl}
              class="mt-5 inline-block rounded-xl border border-input bg-secondary px-5 py-2.5 font-medium text-secondary-foreground hover:bg-muted"
            >
              Ver el código
            </a>
          </div>
        </div>
        <p class="mt-4 mb-0 text-sm text-muted-foreground">
          Todavía no cobramos: cuando activemos los pagos te avisaremos con 30 días de antelación y podrás exportar tus
          datos o borrar tu cuenta si no quieres continuar.
        </p>
      </section>
    </main>
</Base>
