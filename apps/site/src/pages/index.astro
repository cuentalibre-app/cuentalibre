</Base>

<script>
  // Segmented controls: slide the white pill under the chosen option
  const placeIndicators = () => {
    for (const group of document.querySelectorAll<HTMLElement>("[data-indicator-group]")) {
      const indicator = group.querySelector<HTMLElement>("[data-indicator]")!;
      const active = group.querySelector<HTMLElement>('[aria-selected="true"], [aria-pressed="true"]');
      if (!active) continue;
      const first = !group.hasAttribute("data-ready");
      // The first placement jumps into position instead of sliding from the corner
      if (first) indicator.style.transition = "none";
      indicator.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
      indicator.style.width = `${active.offsetWidth}px`;
      indicator.style.height = `${active.offsetHeight}px`;
      indicator.style.borderRadius = getComputedStyle(active).borderRadius;
      if (first) {
        indicator.getBoundingClientRect();
        indicator.style.transition = "";
        group.setAttribute("data-ready", "");
      }
    }
  };
  placeIndicators();
  document.fonts.ready.then(placeIndicators);
  window.addEventListener("resize", placeIndicators);

  // Hero: switch the screenshot with the tabs, and move between tabs with the arrow keys
  for (const root of document.querySelectorAll<HTMLElement>("[data-screens]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        document.getElementById(other.getAttribute("aria-controls")!)!.hidden = !selected;
      }
      // On narrow screens the tabs scroll sideways: keep the chosen one in view
      tab.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
      placeIndicators();
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const i = tabs.indexOf(tab);
        const next = {
          ArrowRight: tabs[(i + 1) % tabs.length],
          ArrowLeft: tabs[(i - 1 + tabs.length) % tabs.length],
          Home: tabs[0],
          End: tabs[tabs.length - 1],
        }[event.key];
        if (!next) return;
        event.preventDefault();
        select(next);
        next.focus();
      });
    }
  }

  // Features: page through the cards and disable the arrow at each end
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]")!;
    // Each direction has a button in the header (wide screens) and one over the cards (phones)
    const prev = root.querySelectorAll<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelectorAll<HTMLButtonElement>("[data-carousel-next]");
    const step = () => {
      const card = track.firstElementChild;
      return card ? card.getBoundingClientRect().width + 20 : track.clientWidth * 0.8;
    };
    const syncEnds = () => {
      for (const button of prev) button.disabled = track.scrollLeft <= 4;
      for (const button of next) button.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    for (const button of prev) button.addEventListener("click", () => track.scrollBy({ left: -step() }));
    for (const button of next) button.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", syncEnds, { passive: true });
    window.addEventListener("resize", syncEnds);
    syncEnds();
  }

  // Price: show the hosted plan's price for the chosen billing period
  for (const root of document.querySelectorAll<HTMLElement>("[data-billing]")) {
    const options = root.querySelectorAll<HTMLButtonElement>("[data-billing-option]");
    for (const option of options) {
      option.addEventListener("click", () => {
        const billing = option.dataset.billingOption;
        for (const other of options) other.setAttribute("aria-pressed", String(other === option));
        for (const price of root.querySelectorAll<HTMLElement>("[data-billing-show]")) {
          price.hidden = price.dataset.billingShow !== billing;
        }
        placeIndicators();
      });
    }
  }

  // Fetch the other screenshots once the page is idle, so switching tabs never shows a blank frame
  const preload = () => {
    for (const img of document.querySelectorAll<HTMLImageElement>('[role="tabpanel"][hidden] img')) img.loading = "eager";
  };
  addEventListener("load", () => ("requestIdleCallback" in window ? requestIdleCallback(preload) : setTimeout(preload, 1500)));
</script>
