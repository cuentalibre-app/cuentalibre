---
import { Image } from "astro:assets";
import Icon, { type IconName } from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Base from "../layouts/Base.astro";
import { appLinks, cloudBilling, demoLinkAttrs, sourceUrl } from "../site";

import bancos from "../assets/screens/bancos.jpg";
import calendario from "../assets/screens/calendario.jpg";
import cierre from "../assets/screens/cierre.jpg";
import facturaEditor from "../assets/screens/factura-editor.jpg";
import facturasMovil from "../assets/screens/facturas-movil.jpg";
import facturas from "../assets/screens/facturas.jpg";
import gastosMovil from "../assets/screens/gastos-movil.jpg";
import gastos from "../assets/screens/gastos.jpg";
import impuestosMovil from "../assets/screens/impuestos-movil.jpg";
import impuestos from "../assets/screens/impuestos.jpg";
import inicioMovil from "../assets/screens/inicio-movil.jpg";
import inicio from "../assets/screens/inicio.jpg";
import modelo303 from "../assets/screens/modelo-303.jpg";
import perdidasGanancias from "../assets/screens/perdidas-ganancias.jpg";

const title = "cuentalibre: facturas e impuestos para autónomos, gratis y de código abierto";
const description =
  "Haz facturas, apunta gastos y mira cada trimestre lo que te toca pagar de IVA e IRPF. Gratis en tu servidor o desde 4,08 €/mes en el nuestro.";

/** Screens of the app the hero switches between; captured from the demo. */
const screens: {
  id: string;
  label: string;
  icon: IconName;
  caption: string;
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
}[] = [
  {
    id: "inicio",
    label: "Inicio",
    icon: "layout-dashboard",
    caption: "Ingresos, gastos, beneficio y lo que te queda después de impuestos.",
    desktop: inicio,
    mobile: inicioMovil,
    alt: "Inicio: resumen del año con ingresos, gastos, beneficio e impuestos estimados",
  },
  {
    id: "facturas",
    label: "Facturas",
    icon: "receipt",
    caption: "Facturas con su estado de cobro, IVA y retención.",
    desktop: facturas,
    mobile: facturasMovil,
    alt: "Lista de facturas emitidas del año",
  },
  {
    id: "impuestos",
    label: "Impuestos",
    icon: "percent",
    caption: "Lo que sale a pagar en cada trimestre y el próximo plazo.",
    desktop: impuestos,
    mobile: impuestosMovil,
    alt: "Resumen de impuestos por trimestre",
  },
  {
    id: "gastos",
    label: "Gastos",
    icon: "shopping-bag",
    caption: "Cuota de autónomos, tickets y gastos deducibles con su justificante.",
    desktop: gastos,
    mobile: gastosMovil,
    alt: "Lista de gastos con su parte deducible",
  },
  {
    id: "calendario",
    label: "Calendario",
    icon: "calendar-check",
    caption: "Solo los modelos que te afectan, con su fecha.",
    desktop: calendario,
    mobile: impuestosMovil,
    alt: "Calendario fiscal del año por modelo",
  },
  {
    id: "bancos",
    label: "Bancos",
    icon: "landmark",
    caption: "Lo que cobras y pagas cada mes, y por qué cuenta pasa.",
    desktop: bancos,
    mobile: inicioMovil,
    alt: "Resumen de bancos con los cobros y pagos del año",
  },
];

const features = [
  {
    tag: "Ventas",
    title: "Facturas en un minuto",
    text: "Facturas, presupuestos y albaranes con numeración correlativa y PDF.",
    image: facturaEditor,
    alt: "Editor de facturas",
  },
  {
    tag: "Compras",
    title: "Cada gasto, con su parte deducible",
    text: "Cuota de autónomos, tickets y facturas recibidas, con su justificante.",
    image: gastos,
    alt: "Lista de gastos",
  },
  {
    tag: "Impuestos",
    title: "Tus modelos, ya calculados",
    text: "El 303 y el 130 cada trimestre y el 390 a final de año, con el fichero para presentarlos en la sede de la AEAT.",
    image: modelo303,
    alt: "Modelo 303 calculado",
  },
  {
    tag: "Impuestos",
    title: "Calendario fiscal",
    text: "Cada plazo que te afecta, con el importe antes de que llegue.",
    image: calendario,
    alt: "Calendario fiscal",
  },
  {
    tag: "Bancos",
    title: "Cobros y pagos",
    text: "Cada cobro y pago de tus facturas y gastos, con la cuenta por la que pasó.",
    image: bancos,
    alt: "Cobros y pagos",
  },
  {
    tag: "Cierre",
    title: "Cierre de trimestre",
    text: "Una lista de lo pendiente antes de presentar tus impuestos.",
    image: cierre,
    alt: "Cierre de trimestre",
  },
  {
    tag: "Informes",
    title: "Pérdidas y ganancias",
    text: "Tu año frente al anterior, exportable a PDF.",
    image: perdidasGanancias,
    alt: "Informe de pérdidas y ganancias",
  },
];

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "code",
    title: "Código abierto",
    text: "Puedes leer el código que calcula tu IVA y tu IRPF, revisarlo y mejorarlo.",
  },
  {
    icon: "lock-keyhole",
    title: "Tus datos, en tu sitio",
    text: "Tus datos fiscales no son nuestro negocio: no los vendemos ni los cedemos. Expórtalos o bórralos cuando quieras.",
  },
  {
    icon: "hand-coins",
    title: "Gratis en tu servidor",
    text: "Instalado en tu servidor tienes todas las funciones, sin pagar nada. Cloud cuesta desde 4,08 €/mes y no tienes que instalar nada.",
  },
];

/** Comparison rows: a string is shown as text, a boolean as a check or a cross. */
const comparison: { label: string; badge?: string; others: string | boolean; ours: string | boolean }[] = [
  { label: "Facturas y gastos ilimitados", others: "De pago", ours: "Gratis" },
  { label: "IVA, IRPF y calendario fiscal", others: "De pago", ours: "Gratis" },
  { label: "Conéctalo a tus agentes de IA", badge: "API incluida", others: "De pago", ours: "Gratis" },
  { label: "Código abierto y auditable", others: false, ours: true },
  { label: "Puedes instalarlo en tu servidor", others: false, ours: true },
];

const freePlan = [
  "Facturas, presupuestos y gastos ilimitados",
  "IVA e IRPF de cada trimestre, ya calculados",
  "Calendario fiscal y cierre de trimestre",
  "Cobros, pagos e informes",
  "API para tus agentes de IA",
  "Tus datos no salen de tu servidor",
];

const onlinePlan = [
  "Sin instalar nada, desde cualquier navegador",
  "Actualizaciones automáticas",
  "Copia de seguridad diaria",
  "Exporta tus datos cuando quieras",
];

/** Questions people ask before trusting the app with their taxes. */
const faqs = [
  {
    question: "¿Presenta los modelos por mí?",
    answer:
      "No. Calcula cada casilla y te da el fichero del modelo. Lo subes en la sede electrónica de la AEAT y lo presentas tú, con tu certificado o Cl@ve.",
  },
  {
    question: "¿Qué pasa si cuentalibre deja de existir?",
    answer:
      "El código es abierto y seguirá publicado, así que siempre podrás instalarlo en tu servidor. Y puedes exportar tus datos cuando quieras.",
  },
  {
    question: "¿Cuál de los dos elijo?",
    answer:
      "Si no tienes un servidor o no sabes qué es Docker, Cloud: te registras y empiezas. Si ya tienes uno, instálalo desde GitHub y úsalo gratis.",
  },
];

const defaultBilling = "yearly";

/** In the big prices a monospaced space reads as a gap, so the euro sign gets a narrow margin instead */
const euroSign = "ml-[0.28em]";

/** White pill that slides under the chosen tab; the script places it and marks the group ready */
const indicator =
  "pointer-events-none absolute top-0 left-0 rounded-[10px] bg-background opacity-0 shadow-tab transition-[transform,width,height] duration-300 ease-out in-data-ready:opacity-100";
const eyebrow = "text-[14px] font-semibold text-primary";
const sectionTitle =
  "font-display text-[clamp(32px,4vw,44px)] leading-[1.08] font-semibold tracking-[-0.025em] text-balance";
/** Call-to-action pair: compact pills, stacked and centered on phones, side by side from sm */
const buttonRow = "flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center";
const pill = "inline-flex min-w-[216px] items-center justify-center gap-2 rounded-full px-5 py-2.5 text-[15px] no-underline sm:min-w-0";
const primaryButton = `${pill} font-semibold button-brand`;
const secondaryButton = `${pill} border border-input font-medium text-foreground transition-[background-color,transform] duration-150 hover:bg-muted active:scale-[0.98]`;
---

<Base title={title} description={description}>
  <main>
    <section class="mx-auto max-w-[1200px] px-4 pt-8 text-center sm:px-6 sm:pt-14 md:pt-22">
      <h1
        class="mx-auto mt-4 mb-0 max-w-[1000px] animate-rise-in font-display text-[clamp(40px,6.6vw,80px)] sm:mt-7 leading-[1.02] font-semibold tracking-[-0.025em] text-balance"
      >
        Impuestos al día.<br /><span class="text-gradient-brand">Gratis y de código abierto.</span>
      </h1>
      <p class="mx-auto mt-5 mb-0 max-w-[560px] animate-rise-in text-[17px] [--i:2] leading-normal sm:mt-6 sm:text-[19px] text-pretty text-muted-foreground">
        Haz facturas, apunta gastos y mira cada trimestre lo que te toca pagar de IVA e IRPF. Puedes leer el código que lo calcula.
      </p>
      <div class:list={[buttonRow, "mt-8 animate-rise-in [--i:4] sm:mt-9"]}>
        <a href={appLinks.demo} {...demoLinkAttrs} class={primaryButton}>
          Probar la demo<Icon name="arrow-right" class="size-[18px]" />
        </a>
        <a href="#precio" class={secondaryButton}>Ver precios</a>
      </div>
    </section>

    <section class="mx-auto mt-12 max-w-[1240px] animate-rise-in px-4 [--i:6] sm:mt-16 sm:px-6" data-screens>
      <div
        role="tablist"
        aria-label="Pantallas de la app"
        data-indicator-group
        class="scrollbar-none relative mx-auto flex w-fit max-w-full gap-1 overflow-x-auto rounded-[14px] bg-muted p-1 md:flex-wrap md:justify-center"
      >
        <span data-indicator aria-hidden="true" class={indicator}></span>
        {
          screens.map((screen, i) => (
            <button
              type="button"
              role="tab"
              id={`pantalla-${screen.id}`}
              aria-controls={`panel-${screen.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="inline-flex shrink-0 items-center gap-[7px] rounded-[10px] border-0 bg-transparent px-3.5 py-2 whitespace-nowrap font-[inherit] text-[15px] font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-background aria-selected:text-foreground aria-selected:shadow-tab relative z-10 in-data-ready:aria-selected:bg-transparent in-data-ready:aria-selected:shadow-none"
            >
              <Icon name={screen.icon} class="size-[17px]" />
              {screen.label}
            </button>
          ))
        }
      </div>
      {
        screens.map((screen, i) => (
          <div role="tabpanel" id={`panel-${screen.id}`} aria-labelledby={`pantalla-${screen.id}`} hidden={i !== 0}>
            <p class="mx-auto mt-4 mb-0 min-h-6 text-center text-[15px] text-muted-foreground">{screen.caption}</p>
            <div class="relative mt-5 md:pb-12">
              <div class="hidden rounded-[20px] border border-border bg-sidebar p-2 shadow-frame md:block">
                <Image
                  src={screen.desktop}
                  alt={screen.alt}
                  widths={[800, 1200, 1600, 2400]}
                  sizes="(min-width: 1240px) 1176px, calc(100vw - 48px)"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  class="block aspect-[1440/900] h-auto w-full rounded-[13px] border border-accent bg-background object-cover object-top-left"
                />
              </div>
              <div class="mx-auto w-[min(260px,72vw)] rounded-[40px] bg-foreground p-[9px] shadow-phone md:absolute md:right-[-12px] md:bottom-0 md:mx-0 md:w-[21%] md:max-w-[250px]">
                <Image
                  src={screen.mobile}
                  alt="cuentalibre en el móvil"
                  widths={[260, 520]}
                  sizes="260px"
                  loading={i === 0 ? "eager" : "lazy"}
                  class="block aspect-[390/820] h-auto w-full rounded-[32px] bg-background object-cover object-top"
                />
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <section id="funciones" class="mt-14 sm:mt-20 md:mt-30" data-carousel>
      <div data-reveal class="mx-auto flex max-w-[1200px] flex-wrap items-end justify-between gap-6 px-4 sm:px-6">
        <div>
          <div class={eyebrow}>Funciones</div>
          <h2 class:list={[sectionTitle, "mt-2 mb-0"]}>Todo tu trimestre, en una app</h2>
          <p class="mt-2.5 mb-0 max-w-[520px] text-[17px] text-muted-foreground">
            Facturas, gastos, modelos de la AEAT, bancos e informes. Las mismas funciones en los dos planes.
          </p>
        </div>
        <div class="hidden items-center gap-4 sm:flex">
          <a
            href={appLinks.demo}
            {...demoLinkAttrs}
            class="hidden items-center gap-1.5 font-semibold text-primary no-underline hover:text-primary-hover md:inline-flex"
          >
            Verlo todo en la demo<Icon name="arrow-right" class="size-[17px]" />
          </a>
          <div class="flex gap-2">
            <button
              type="button"
              aria-label="Función anterior"
              data-carousel-prev
              disabled
              class="flex size-10 items-center justify-center rounded-full sm:size-12 border border-border bg-background p-0 text-foreground hover:bg-muted disabled:cursor-default disabled:opacity-35"
            >
              <Icon name="chevron-left" />
            </button>
            <button
              type="button"
              aria-label="Función siguiente"
              data-carousel-next
              class="flex size-10 items-center justify-center rounded-full sm:size-12 border-0 bg-foreground p-0 text-background hover:bg-primary-hover disabled:cursor-default disabled:opacity-35"
            >
              <Icon name="chevron-right" />
            </button>
          </div>
        </div>
      </div>
      <div data-reveal class="relative mt-6 sm:mt-10">
      <ul
        data-carousel-track
        class="scrollbar-none m-0 flex list-none snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-[max(16px,calc((100%-1152px)/2))] pt-1 pb-6 scroll-pl-[max(16px,calc((100%-1152px)/2))] sm:px-[max(24px,calc((100%-1152px)/2))] sm:scroll-pl-[max(24px,calc((100%-1152px)/2))]"
      >
        {
          features.map((feature) => (
            <li class="flex w-[min(540px,84vw)] shrink-0 snap-start flex-col overflow-hidden rounded-[24px] border border-divider bg-sidebar/60 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-shot">
              <div class="px-6 pt-6 pb-6 sm:px-8 sm:pt-7 sm:pb-7">
                <div class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">{feature.tag}</div>
                <h3 class="mt-2 mb-0 text-[20px] leading-tight sm:text-[22px] font-semibold tracking-[-0.015em]">{feature.title}</h3>
                <p class="mt-2 mb-0 max-w-[420px] text-muted-foreground">{feature.text}</p>
              </div>
              <div class="mt-auto ml-6 h-[240px] shrink-0 overflow-hidden sm:h-[340px] rounded-tl-[14px] border-t border-l border-input bg-background shadow-screen sm:ml-8">
                <Image
                  src={feature.image}
                  alt={feature.alt}
                  widths={[800, 1200]}
                  sizes="min(810px, 126vw)"
                  loading="lazy"
                  class="block h-auto min-h-full w-[150%] max-w-none object-cover object-top-left"
                />
              </div>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Función anterior"
        data-carousel-prev
        disabled
        class="absolute top-1/2 left-2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/90 p-0 text-foreground shadow-shot backdrop-blur transition-opacity disabled:pointer-events-none disabled:opacity-0 sm:hidden"
      >
        <Icon name="chevron-left" />
      </button>
      <button
        type="button"
        aria-label="Función siguiente"
        data-carousel-next
        class="absolute top-1/2 right-2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/90 p-0 text-foreground shadow-shot backdrop-blur transition-opacity disabled:pointer-events-none disabled:opacity-0 sm:hidden"
      >
        <Icon name="chevron-right" />
      </button>
      </div>
    </section>

    <section id="privacidad" class="mx-auto mt-10 sm:mt-20 md:mt-30 max-w-[1200px] px-4 sm:px-6">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)] lg:items-center lg:gap-16">
        <div>
          <div data-reveal class="text-center lg:text-left">
            <div class={eyebrow}>Por qué cuentalibre</div>
            <h2 class:list={[sectionTitle, "mx-auto mt-2 mb-0 lg:mx-0"]}>Tus cuentas son <em>tuyas</em>.</h2>
            <p class="mt-4 mb-0 hidden max-w-[520px] text-[17px] text-muted-foreground lg:block">
              Tus datos fiscales, con un software que puedes revisar, auditar y ejecutar en tu propio servidor.
            </p>
          </div>
          <ul class="m-0 mt-8 grid list-none grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6 p-0 sm:mt-12 sm:gap-10 lg:mt-10 lg:grid-cols-1 lg:gap-7">
            {
              reasons.map((reason, i) => (
                <li
                  data-reveal
                  style={{ "--i": i }}
                  class="grid grid-cols-[20px_1fr] items-center gap-x-3 sm:block lg:grid lg:grid-cols-[24px_1fr] lg:items-start lg:gap-x-4"
                >
                  <div class="flex items-center justify-center text-primary sm:size-11 sm:rounded-[12px] sm:bg-primary-soft lg:mt-1 lg:size-6 lg:rounded-none lg:bg-transparent">
                    <Icon name={reason.icon} class="size-5 sm:size-[22px]" />
                  </div>
                  <h3 class="m-0 text-[18px] font-semibold tracking-[-0.015em] sm:mt-5 sm:text-[20px] lg:mt-0 lg:font-display lg:text-[24px] lg:leading-tight">
                    {reason.title}
                  </h3>
                  <p class="col-start-2 mt-1 mb-0 text-muted-foreground sm:mt-2 lg:mt-1.5">{reason.text}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-reveal style={{ "--i": 2 }} class="mx-auto mt-12 max-w-[760px] overflow-hidden rounded-[24px] border border-accent sm:mt-16 lg:mt-0 lg:max-w-none">
          <div class="px-5 py-6 sm:px-10 sm:py-8 lg:px-7">
            <table class="w-full border-separate border-spacing-0 text-[14px] sm:text-[15px]">
              <thead>
                <tr>
                  <th scope="col" class="py-2.5"><span class="sr-only">Función</span></th>
                  <th scope="col" class="w-[76px] pb-3 align-bottom text-center text-xs font-medium sm:w-24 sm:text-sm text-muted-foreground">Otros</th>
                  <th scope="col" class="w-[96px] rounded-t-[16px] bg-primary-soft pt-4 pb-3 align-bottom text-xs font-semibold text-primary sm:w-28 sm:text-sm">
                    <span class="flex flex-col items-center gap-1.5">
                      <Logo class="h-[22px] w-5 text-foreground" />
                      cuentalibre
                    </span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  comparison.map((row, i) => (
                    <tr>
                      <th scope="row" class="border-t border-divider py-3.5 pr-2 text-left font-normal sm:py-4">
                        <span class="flex flex-wrap items-center gap-2">
                          {row.label}
                          {row.badge && (
                            <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-semibold text-primary-hover">
                              {row.badge}
                            </span>
                          )}
                        </span>
                      </th>
                      <td class="border-t border-divider py-4 text-center text-sm text-muted-foreground">
                        {typeof row.others === "string" ? (
                          row.others
                        ) : (
                          <Icon name="x" label="No" class="mx-auto block size-[18px] text-input" />
                        )}
                      </td>
                      <td
                        class:list={[
                          "border-t border-primary/15 bg-primary-soft py-4 text-center text-sm font-semibold text-primary",
                          i === comparison.length - 1 && "rounded-b-[16px]",
                        ]}
                      >
                        {typeof row.ours === "string" ? (
                          row.ours
                        ) : (
                          <span class="mx-auto flex size-6 items-center justify-center rounded-full bg-primary text-primary-foreground">
                            <Icon name="check" label="Sí" class="size-3.5 [stroke-width:3]" />
                          </span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="precio" class="mx-auto mt-16 sm:mt-24 md:mt-34 max-w-[1200px] px-4 sm:px-6" data-billing={defaultBilling}>
      <div data-reveal class="text-center">
        <div class={eyebrow}>Precio</div>
        <h2 class:list={[sectionTitle, "mx-auto mt-2 mb-0"]}>Gratis en tu servidor. O en el nuestro.</h2>
        <p class="mx-auto mt-3.5 mb-0 max-w-[540px] text-[17px] text-muted-foreground">
          Las dos opciones tienen todas las funciones. Solo cambia quién se encarga del servidor.
        </p>
        <div
          role="group"
          aria-label="Forma de pago"
          data-indicator-group
          class="relative mx-auto mt-7 grid w-full max-w-[360px] grid-cols-3 gap-1 rounded-[12px] bg-muted p-1 sm:flex sm:w-fit sm:max-w-none"
        >
          <span data-indicator aria-hidden="true" class={indicator}></span>
          {
            cloudBilling.map((option) => (
              <button
                type="button"
                data-billing-option={option.id}
                aria-pressed={option.id === defaultBilling ? "true" : "false"}
                class="inline-flex items-center justify-center gap-2 rounded-[9px] border-0 bg-transparent px-2 py-2 sm:px-4 font-[inherit] text-[15px] font-medium text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-tab relative z-10 in-data-ready:aria-pressed:bg-transparent in-data-ready:aria-pressed:shadow-none"
              >
                {option.label}
                {option.saving && (
                  <span class="hidden rounded-full bg-success-soft px-[7px] py-px text-xs font-semibold whitespace-nowrap text-success sm:inline">
                    −{option.saving}
                  </span>
                )}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mx-auto mt-12 grid max-w-[960px] grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-4">
        <div data-reveal class="flex flex-col rounded-[24px] border border-accent bg-background p-6 sm:p-8">
          <div class="flex items-center gap-3">
