          }
          <details class="group/plan mt-6 flex flex-1 flex-col border-t border-primary-soft sm:mt-7 sm:details-content:contents">
            <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[15px] font-semibold sm:hidden [&::-webkit-details-marker]:hidden">
              Qué incluye
