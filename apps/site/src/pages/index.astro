        </div>

        <div data-reveal style={{ "--i": 1 }} class="border-gradient-brand flex flex-col rounded-[24px] p-6 text-foreground shadow-plan sm:p-8">
          <div class="flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-[10px] bg-primary text-primary-foreground">
              <Icon name="cloud" />
            </div>
            <div>
              <h3 class="m-0 text-[18px] font-semibold">cuentalibre Cloud</h3>
