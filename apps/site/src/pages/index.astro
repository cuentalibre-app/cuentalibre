<script>
  import { placeIndicators } from "../scripts/indicators";

  // Hero: switch the screenshot with the tabs, and move between tabs with the arrow keys
  for (const root of document.querySelectorAll<HTMLElement>("[data-screens]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        document.getElementById(other.getAttribute("aria-controls")!)!.hidden = !selected;
      }
      // On narrow screens the tabs scroll sideways: keep the chosen one in view
      tab.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
      placeIndicators();
    };
    // Swiping the screenshot sideways moves to the next or previous screen
    let touchStart: Touch | undefined;
    root.addEventListener("touchstart", (event) => (touchStart = event.touches[0]), { passive: true });
    root.addEventListener("touchend", (event) => {
      const end = event.changedTouches[0];
      if (!touchStart || !end || (event.target as Element).closest('[role="tablist"]')) return;
      const dx = end.clientX - touchStart.clientX;
      const dy = end.clientY - touchStart.clientY;
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      const i = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      const target = tabs[dx < 0 ? Math.min(i + 1, tabs.length - 1) : Math.max(i - 1, 0)];
      if (target && target !== tabs[i]) select(target);
    });
    for (const tab of tabs) {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const i = tabs.indexOf(tab);
        const next = {
          ArrowRight: tabs[(i + 1) % tabs.length],
          ArrowLeft: tabs[(i - 1 + tabs.length) % tabs.length],
          Home: tabs[0],
          End: tabs[tabs.length - 1],
        }[event.key];
        if (!next) return;
        event.preventDefault();
        select(next);
        next.focus();
      });
    }
  }

  // Price: show the hosted plan's price for the chosen billing period
  for (const root of document.querySelectorAll<HTMLElement>("[data-billing]")) {
    const options = root.querySelectorAll<HTMLButtonElement>("[data-billing-option]");
    for (const option of options) {
      option.addEventListener("click", () => {
        const billing = option.dataset.billingOption;
        for (const other of options) other.setAttribute("aria-pressed", String(other === option));
        for (const price of root.querySelectorAll<HTMLElement>("[data-billing-show]")) {
          price.hidden = price.dataset.billingShow !== billing;
        }
        placeIndicators();
      });
    }
  }

  // Scanner: play the clip in the site's theme while it is on screen; reduced motion shows its still frame
  for (const video of document.querySelectorAll<HTMLVideoElement>("[data-scanner]")) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let onScreen = false;
    const sync = () => {
      const name = document.documentElement.classList.contains("dark") ? "escaner-oscuro" : "escaner-claro";
      if (video.dataset.clip !== name) {
        video.dataset.clip = name;
        video.poster = `/videos/${name}-poster.jpg`;
        video.src = `/videos/${name}.mp4`;
        if (video.preload !== "none") video.load();
      }
      if (onScreen && !still.matches) {
        video.preload = "auto";
        video.play().catch(() => {});
      } else video.pause();
    };
    new IntersectionObserver(([entry]) => {
      onScreen = !!entry?.isIntersecting;
      sync();
    }, { rootMargin: "200px 0px" }).observe(video);
    addEventListener("site-theme-change", sync);
    still.addEventListener("change", sync);
    sync();
  }

  // Fetch the other screenshots once the page is idle, so switching tabs never shows a blank frame
  const shotTheme = () => (document.documentElement.classList.contains("dark") ? "dark" : "light");
  const preload = (theme = shotTheme()) => {
    for (const img of document.querySelectorAll<HTMLImageElement>(`[data-shot="${theme}"] img`)) img.loading = "eager";
  };
  // Switching the site's theme fetches that theme's screenshots straight away
  addEventListener("site-theme-change", () => preload());
  addEventListener("load", () => ("requestIdleCallback" in window ? requestIdleCallback(() => preload()) : setTimeout(preload, 1500)));
</script>
