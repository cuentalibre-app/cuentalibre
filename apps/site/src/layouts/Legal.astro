---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  /** Date of the last change, as people read it ("21 de octubre de 2026"). */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} · cuentalibre`} description={description}>
  <main class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6">
    <h1 class="m-0 text-3xl font-semibold tracking-tight">{title}</h1>
    <p class="mt-2 mb-0 text-sm text-muted-foreground">Última actualización: {updated}</p>
    <article class="legal text-md">
      <slot />
    </article>
  </main>
</Base>
