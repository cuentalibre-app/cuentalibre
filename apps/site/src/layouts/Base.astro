---
import "../styles/global.css";
import { appLinks, legalPages, sourceUrl } from "../site";

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
      <a href="/" class="text-md font-semibold text-foreground no-underline">cuentalibre</a>
      <nav class="flex items-center gap-2">
        <a href={appLinks.signIn} class="rounded-lg px-3 py-2 font-medium text-foreground hover:bg-accent">Entrar</a>
        <a
          href={appLinks.signUp}
          class="rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground hover:bg-primary-hover"
        >
          Crear cuenta
        </a>
      </nav>
    </header>

    <slot />

    <footer
      class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between sm:px-6"
    >
      <span>cuentalibre · Software libre bajo licencia AGPL-3.0</span>
      <nav class="flex flex-wrap gap-x-4 gap-y-2">
        {
          legalPages.map((page) => (
            <a href={page.path} class="text-muted-foreground hover:text-foreground">
              {page.label}
            </a>
          ))
        }
        <a href={sourceUrl} class="text-muted-foreground hover:text-foreground">Código fuente</a>
      </nav>
    </footer>
  </body>
</html>
