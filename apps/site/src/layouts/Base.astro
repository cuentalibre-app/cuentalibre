---
import "../styles/global.css";
import GitHubIcon from "../components/GitHubIcon.astro";
import Logo from "../components/Logo.astro";
import { appLinks, demoLinkAttrs, legalPages, sourceUrl } from "../site";

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const sections = [
  { href: "/#funciones", label: "Funciones" },
  { href: "/#privacidad", label: "Privacidad" },
  { href: "/#precio", label: "Precio" },
];

/** The header links: the home page's sections, then the pages beside it. */
const navLinks = [...sections, { href: "/docs", label: "Docs" }];

const footerColumns = [
  {
    title: "Producto",
    links: [...navLinks, { href: appLinks.demo, label: "Probar la demo" }, { href: appLinks.signIn, label: "Entrar" }],
  },
  {
    title: "Proyecto",
    links: [
      { href: sourceUrl, label: "Código fuente" },
      { href: `${sourceUrl}/issues`, label: "Informar de un problema" },
      { href: `${sourceUrl}/blob/main/LICENSE`, label: "Licencia AGPL-3.0" },
    ],
  },
  { title: "Legal", links: legalPages.map((page) => ({ href: page.path, label: page.label })) },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="cuentalibre" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Lets CSS hide what the page script will animate in; without scripts everything shows -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <div
      data-site-header
      class="sticky top-0 z-50 border-b border-transparent bg-background/80 backdrop-blur-md transition-colors duration-300 data-scrolled:border-divider"
    >
    <header class="mx-auto flex max-w-[1200px] items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
      <a
        href="/"
        class="flex shrink-0 items-baseline gap-2 text-[17px] font-semibold tracking-[-0.01em] text-foreground no-underline sm:gap-2.5 sm:text-[19px]"
      >
        <Logo />
        cuentalibre
      </a>
      <nav class="hidden gap-7 text-[15px] lg:flex" aria-label="Secciones">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={Astro.url.pathname.startsWith(link.href) ? "page" : undefined}
              class="text-muted-foreground no-underline hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="flex items-center gap-1 sm:gap-2">
        <a
          href={sourceUrl}
          class="hidden items-center gap-1.5 rounded-[10px] px-3 py-2 text-[15px] font-medium text-foreground no-underline hover:bg-muted lg:flex"
        >
          <GitHubIcon class="size-[18px]" />GitHub
        </a>
        <a
          href={appLinks.signIn}
          class="rounded-[10px] px-2.5 py-2 text-[14px] font-medium text-foreground no-underline hover:bg-muted sm:px-3.5 sm:text-[15px]"
        >
          Entrar
        </a>
        <a
          href={appLinks.demo}
          {...demoLinkAttrs}
          class="rounded-full bg-foreground px-3.5 py-2 text-[14px] font-semibold whitespace-nowrap text-background no-underline hover:bg-primary-hover sm:px-4 sm:text-[15px]"
        >
          <span class="sm:hidden">Demo</span><span class="hidden sm:inline">Probar la demo</span>
        </a>
      </div>
    </header>
    </div>

    <slot />

    <footer class="mx-auto mt-20 max-w-[1200px] border-t border-divider px-4 pt-12 pb-10 sm:px-6 md:mt-30 md:pt-16">
      <div class="grid gap-12 md:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] md:gap-8">
        <div>
          <a href="/" class="flex w-fit items-baseline gap-2.5 text-[19px] font-semibold text-foreground no-underline">
            <Logo />
            cuentalibre
          </a>
          <p class="mt-4 mb-0 max-w-[340px] text-[15px] text-muted-foreground">
            Contabilidad e impuestos para autónomos. Privada, gratis y de código abierto.
          </p>
          <a
            href={sourceUrl}
            aria-label="cuentalibre en GitHub"
            class="mt-6 flex size-11 items-center justify-center rounded-full bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"
          >
            <GitHubIcon />
          </a>
        </div>
        {
          footerColumns.map((column) => (
            <nav aria-label={column.title}>
              <h2 class="m-0 text-[15px] font-semibold text-foreground">{column.title}</h2>
              <ul class="m-0 mt-4 flex list-none flex-col gap-1 p-0">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...(link.href === appLinks.demo ? demoLinkAttrs : {})}
                      class="inline-block py-1.5 text-[15px] text-muted-foreground no-underline hover:text-foreground"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
      <p class="mt-12 mb-0 border-t border-divider pt-6 text-[14px] text-muted-foreground">
        © {year} cuentalibre · Software libre bajo licencia AGPL-3.0
      </p>
    </footer>
    <script>
      // The sticky header shows its bottom border once the page has scrolled under it
      const header = document.querySelector<HTMLElement>("[data-site-header]")!;
      const sync = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
      window.addEventListener("scroll", sync, { passive: true });
      sync();

      // Reveal content as it scrolls into view, once
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      for (const el of document.querySelectorAll("[data-reveal]")) reveal.observe(el);
    </script>
  </body>
</html>
