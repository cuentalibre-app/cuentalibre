---
import { Image } from "astro:assets";

/**
 * A light Safari window around a desktop screenshot of the app: traffic lights, the
 * sidebar and history buttons, the address field and the tab buttons. Everything is
 * sized in container units of the window's width, so it scales with whatever width
 * the parent gives it. Screenshots are captured at 1440×900.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
  class?: string;
}

const { src, alt, loading = "lazy", fetchpriority = "auto", class: className } = Astro.props;
const light = "size-[1cqw] rounded-full";
const icon = "h-[1.3cqw] w-auto fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round]";
---

<div class:list={["@container", className]}>
  <div class="overflow-hidden rounded-[1cqw] border border-border bg-sidebar shadow-window">
    <div
      aria-hidden="true"
      class="flex h-[3.6cqw] items-center gap-[1.6cqw] border-b border-border px-[1.4cqw] text-muted-foreground"
    >
      <span class="flex gap-[0.65cqw]">
        <span class:list={[light, "bg-window-close"]}></span>
        <span class:list={[light, "bg-window-minimize"]}></span>
        <span class:list={[light, "bg-window-zoom"]}></span>
      </span>
      <svg viewBox="0 0 20 16" class:list={[icon, "ml-[0.6cqw]"]} stroke-width="1.4"
        ><rect x="1" y="1" width="18" height="14" rx="3"></rect><path d="M7 1v14"></path></svg
      >
      <span class="flex gap-[1.2cqw]">
        <svg viewBox="0 0 10 16" class={icon} stroke-width="1.6"><path d="M7.5 2 2 8l5.5 6"></path></svg>
        <svg viewBox="0 0 10 16" class:list={[icon, "opacity-40"]} stroke-width="1.6"><path d="M2.5 2 8 8l-5.5 6"></path></svg>
      </span>
      <span
        class="mx-auto flex h-[2.3cqw] w-[38%] items-center justify-center gap-[0.5cqw] rounded-[0.7cqw] bg-muted text-[1cqw] font-medium tracking-[-0.01em] text-foreground"
      >
        <svg viewBox="0 0 12 16" class="h-[0.9cqw] w-auto fill-current text-muted-foreground"
          ><rect x="1" y="7" width="10" height="8" rx="1.6"></rect><path
            d="M3 7V5a3 3 0 0 1 6 0v2"
            class="fill-none stroke-current"
            stroke-width="1.6"></path></svg
        >
        app.cuentalibre.es
      </span>
      <span class="flex gap-[1.6cqw]">
        <svg viewBox="0 0 16 18" class={icon} stroke-width="1.4"
          ><path d="M8 11V1.5M4.5 5 8 1.5 11.5 5"></path><path d="M5.5 7.5H3.5a1.5 1.5 0 0 0-1.5 1.5v6.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5V9a1.5 1.5 0 0 0-1.5-1.5h-2"
          ></path></svg
        >
        <svg viewBox="0 0 16 16" class={icon} stroke-width="1.5"><path d="M8 2v12M2 8h12"></path></svg>
        <svg viewBox="0 0 18 18" class={icon} stroke-width="1.4"
          ><rect x="1" y="5" width="12" height="12" rx="2.5"></rect><path d="M5 1.5h8.5A3.5 3.5 0 0 1 17 5v8.5"></path></svg
        >
      </span>
    </div>
    <Image
      src={src}
      alt={alt}
      widths={[800, 1200, 1600, 2400]}
      sizes="(min-width: 1240px) 1176px, calc(100vw - 48px)"
      loading={loading}
      fetchpriority={fetchpriority}
      class="block aspect-[1440/900] h-auto w-full bg-background object-cover object-top-left"
    />
  </div>
</div>
