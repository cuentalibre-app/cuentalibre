---
/** The cuentalibre mark: three rising bars in the text color and a light slate dot. */
interface Props {
  class?: string;
}

const { class: className = "h-[26px] w-6" } = Astro.props;
---

<svg class={className} viewBox="0 0 192 208" aria-hidden="true">
  <g fill="currentColor">
    <rect x="0" y="132" width="52" height="76" rx="14"></rect>
    <rect x="70" y="88" width="52" height="120" rx="14"></rect>
    <rect x="140" y="68" width="52" height="140" rx="14"></rect>
  </g>
  <circle cx="166" cy="26" r="26" class="fill-brand-mark"></circle>
</svg>
