---
import { Image } from "astro:assets";

/**
 * An iPhone 17 around a phone screenshot of the app: space black edge, side buttons,
 * Dynamic Island, status bar and home indicator. Everything is sized in container
 * units of the phone's width, so it scales with whatever width the parent gives it.
 * Screenshots are captured at 402×874 with the status bar and home indicator areas
 * left empty for the frame to draw on.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "eager" | "lazy";
  class?: string;
}

const { src, alt, loading = "lazy", class: className } = Astro.props;
/** Side buttons: action button and volume on the left, power on the right; offsets as a share of the height. */
const button = "absolute w-[1.1cqw] bg-device-edge";
---

<div class:list={["@container relative", className]}>
  <span aria-hidden="true" class:list={[button, "top-[18%] -left-[0.7cqw] h-[7cqw] rounded-l-[1cqw]"]}></span>
  <span aria-hidden="true" class:list={[button, "top-[25%] -left-[0.7cqw] h-[13cqw] rounded-l-[1cqw]"]}></span>
  <span aria-hidden="true" class:list={[button, "top-[34%] -left-[0.7cqw] h-[13cqw] rounded-l-[1cqw]"]}></span>
  <span aria-hidden="true" class:list={[button, "top-[28%] -right-[0.7cqw] h-[20cqw] rounded-r-[1cqw]"]}></span>
  <div class="relative rounded-[17.5cqw] bg-device-edge p-[1cqw] shadow-phone">
    <div class="rounded-[16.5cqw] bg-device-bezel p-[3.2cqw]">
      <div class="relative overflow-hidden rounded-[13.5cqw] bg-background">
        <Image
          src={src}
          alt={alt}
          widths={[300, 600, 900]}
          sizes="260px"
          loading={loading}
          class="block aspect-[402/874] h-auto w-full object-cover object-top"
        />
        <div
          aria-hidden="true"
          class="absolute inset-x-0 top-0 flex h-[14.5cqw] items-center justify-between px-[9cqw] pt-[1cqw] text-foreground"
        >
          <span class="w-[17cqw] text-center text-[4.2cqw] leading-none font-semibold tracking-[-0.01em]">9:41</span>
          <span class="absolute top-[2.8cqw] left-1/2 h-[9cqw] w-[30cqw] -translate-x-1/2 rounded-full bg-device-bezel"></span>
          <span class="flex items-center gap-[1.4cqw]">
            <svg viewBox="0 0 18 12" class="h-[3cqw] fill-current"
              ><rect x="0" y="8" width="3" height="4" rx="0.8"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="0.8"
              ></rect><rect x="10" y="3" width="3" height="9" rx="0.8"></rect><rect x="15" y="0" width="3" height="12" rx="0.8"
              ></rect></svg
            >
            <svg viewBox="0 0 16 12" class="h-[3cqw] fill-current"
              ><path
                d="M8 2.4c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .6 10.4 10.4 0 0 0 .8 3.5L2 4.8a8.6 8.6 0 0 1 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.3l1.2-1.3A6.8 6.8 0 0 0 8 4.2c-1.8 0-3.4.7-4.6 1.8l1.2 1.3c.9-.8 2.1-1.3 3.4-1.3Zm0 3.6c-.4 0-.8.2-1.1.4L8 11.4l1.1-1.4c-.3-.2-.7-.4-1.1-.4Z"
              ></path></svg
            >
            <svg viewBox="0 0 27 13" class="h-[3.1cqw]"
              ><rect x="0.5" y="0.5" width="23" height="12" rx="3.6" class="fill-none stroke-current opacity-40"></rect><rect
                x="2.2"
                y="2.2"
                width="19.6"
                height="8.6"
                rx="2.2"
                class="fill-current"></rect><path d="M25 4.4v4.2a2.2 2.2 0 0 0 0-4.2Z" class="fill-current opacity-40"></path></svg
            >
          </span>
        </div>
        <span
          aria-hidden="true"
          class="absolute bottom-[2cqw] left-1/2 h-[1.3cqw] w-[35cqw] -translate-x-1/2 rounded-full bg-foreground"
        ></span>
      </div>
    </div>
  </div>
</div>
