{
  "name": "@cuentalibre/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@cuentalibre/contracts": "workspace:*",
    "@cuentalibre/core": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.7.0",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "10.1.0",
    "postgres": "^3.4.9",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
