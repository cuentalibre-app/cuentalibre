# Copy to .env. Every value has a development default; set them all in production.
DATABASE_URL=postgres://cuentalibre:cuentalibre@localhost:5432/cuentalibre
# openssl rand -base64 32
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# When the API serves the web app from its own origin (self-hosting), set this instead of both.
# PUBLIC_URL=https://cuentas.example.com
PORT=3000
# The built web app (apps/web/dist, built with VITE_API_URL=/), served on every path outside /v1.
# WEB_DIR=../web/dist

# Google sign-in: an OAuth client (web application) in Google Cloud, with the redirect URI
# <BETTER_AUTH_URL>/v1/auth/callback/google. Without them the button doesn't show.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Uploaded files: on local disk (default) or in an S3-compatible bucket.
STORAGE_DRIVER=disk
STORAGE_DIR=./data/files
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=cuentalibre
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILE_MAX_BYTES=10485760
# Most bytes an organization's files may take in all; 0 for no limit.
# FILE_QUOTA_BYTES=1073741824

# VERI*FACTU: records are always chained; set test or production to send them to the AEAT.
VERIFACTU_ENV=off
# VERIFACTU_CERT_FILE=./certs/certificate.p12
# VERIFACTU_CERT_PASSWORD=
# VERIFACTU_PRODUCER_NAME=
# VERIFACTU_PRODUCER_TAX_ID=

# Outgoing email: invoices, and links to verify an email or reset a password. Without SMTP_URL
# the web app uses the user's mail client, and neither verification nor password reset is offered.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=facturas@example.com
# Emails about people's accounts come from here instead, if set.
# ACCOUNT_EMAIL_FROM=cuentas@example.com
# Most recipients (to and cc) an organization's emails reach a day and in 30 days; 0 for no limit.
# EMAIL_DAILY_RECIPIENTS=50
# EMAIL_MONTHLY_RECIPIENTS=500

# New passwords found in data breaches are refused, asking Have I Been Pwned with the first five
# characters of their hash. Turn it off on servers that can't reach the internet.
# PASSWORD_BREACH_CHECK=off

# Unexpected errors go to Sentry, with their stack and route but no request data or users.
# SENTRY_DSN=https://key@o0.ingest.de.sentry.io/0

# Charging for the plan with Stripe (cuentalibre Cloud only): all of them, or none and billing is
# off. The three prices of the product, the VAT rate added on top, and the signing secret of the
# webhook endpoint <BETTER_AUTH_URL>/v1/billing/webhook. In development, `stripe listen` prints one:
#   stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed \
#     --forward-to localhost:3000/v1/billing/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_QUARTERLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_TAX_RATE=txr_...
