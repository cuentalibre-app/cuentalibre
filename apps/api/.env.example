# Copy to .env. Every value has a development default; set them all in production.
DATABASE_URL=postgres://fiscalia:fiscalia@localhost:5432/fiscalia
# openssl rand -base64 32
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
PORT=3000

# Uploaded files: on local disk (default) or in an S3-compatible bucket.
STORAGE_DRIVER=disk
STORAGE_DIR=./data/files
