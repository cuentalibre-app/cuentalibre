# The servers' settings. compose.yml sets NODE_ENV, DATABASE_URL and BETTER_AUTH_URL from these.
# Nobody edits `.env` on a server: each one takes these names from its GitHub environment,
# `staging` or `production` (secrets for credentials and personal data, variables for the rest),
# and its deploy writes `.env` with every name in this file that has a value there, and API_IMAGE.
# A new name here needs its secret or variable in both environments before the deploy that uses it.

API_DOMAIN=api.cuentalibre.es
# API_IMAGE=ghcr.io/jesuspb2/cuentalibre-api:latest

# openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
WEB_ORIGIN=https://app.cuentalibre.es

# Uploaded files: an S3-compatible bucket (Hetzner Object Storage), or the `files` volume with STORAGE_DRIVER=disk.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=cuentalibre-files
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Largest upload, and most bytes an organization's files may take in all (0 for no limit).
# FILE_MAX_BYTES=10485760
# FILE_QUOTA_BYTES=1073741824

# Outgoing email. Without SMTP_URL the web app uses the user's mail client.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=facturas@cuentalibre.es
# ACCOUNT_EMAIL_FROM=hola@cuentalibre.es
# Most recipients (to and cc) an organization's emails reach a day and in 30 days; 0 for no limit.
# EMAIL_DAILY_RECIPIENTS=50
# EMAIL_MONTHLY_RECIPIENTS=500
# Staging only: every email goes to this address instead.
# EMAIL_REDIRECT_TO=

# Reading invoices and receipts with AI. Without AI_SCAN_MODEL it is off.
# AI_SCAN_MODEL=
# AI_SCAN_API_KEY=
# AI_SCAN_BASE_URL=
# Cloud: documents per organization a month (unset for no limit), and the model's prices per million tokens.
# AI_SCAN_MONTHLY_DOCUMENTS=30
# AI_SCAN_INPUT_PRICE=
# AI_SCAN_OUTPUT_PRICE=

# The help chat in the app. Without AI_CHAT_MODEL it is off.
# AI_CHAT_MODEL=
# AI_CHAT_API_KEY=
# AI_CHAT_BASE_URL=

# Error reports to Sentry (EU region). Without it, errors only go to the log.
# SENTRY_DSN=

# Google sign-in. Without them it is off.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Billing with Stripe: all of them or none. Staging uses test-mode keys and prices.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_QUARTERLY=
# STRIPE_PRICE_YEARLY=
# STRIPE_TAX_RATE=

# Staging only: the made-up account the seed creates in an empty database.
# SEED_EMAIL=
# SEED_PASSWORD=

