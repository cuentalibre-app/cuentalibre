# Requests reach the server through Cloudflare's proxy, which checks this
# certificate (SSL mode Full (strict)). It is a Cloudflare origin certificate,
# so Caddy needs no ACME challenge.
# Cloudflare also shows a client certificate of our own (Authenticated Origin
# Pulls, zone-level), so other Cloudflare accounts can't reach this origin
# through their own zones: Caddy refuses the TLS handshake without it.
{
	servers {
		# Only Cloudflare may say who the client is. Ranges from https://www.cloudflare.com/ips
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/origin-pull-ca.pem
		}
	}
	encode zstd gzip
	# Nothing the API serves belongs in a search engine, in production or staging.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy api:3000 {
		# Better Auth rate-limits by this header and only trusts it with a single address.
		header_up X-Forwarded-For {client_ip}
	}
}
