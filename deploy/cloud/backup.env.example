# Settings for backup.sh, in the server's backup.env. Kept out of .env,
# which compose passes to the API, so the API can't touch the backups.
# The deploy writes it from the server's GitHub environment, like `.env`.
BACKUP_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_REGION=fsn1
BACKUP_BUCKET=cuentalibre-backups
# A key that can only write to this bucket; restores use a separate one.
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Enable the files archive with these settings. Use a separate read-only key for the source.
# BACKUP_FILES_ENDPOINT=https://fsn1.your-objectstorage.com
# BACKUP_FILES_REGION=fsn1
# BACKUP_FILES_BUCKET=cuentalibre-files
# BACKUP_FILES_ACCESS_KEY_ID=
# BACKUP_FILES_SECRET_ACCESS_KEY=
# Better Stack heartbeat, pinged after each backup (optional).
# BACKUP_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/...
