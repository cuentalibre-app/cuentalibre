# Copy to .env next to compose.yml. More options (email, Google sign-in, S3, VERI*FACTU)
# are explained in apps/api/.env.example.

# The address you open cuentalibre at, as the browser sees it: https://cuentas.tudominio.es,
# or http://192.168.1.20:3000 on your local network.
PUBLIC_URL=http://localhost:3000
# Generate both with `openssl rand -base64 32` and keep them somewhere safe.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# The port on this machine the app listens on.
# PORT=3000
